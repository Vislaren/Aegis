{
  "name": "@aegis/client",
  "version": "0.1.0",
  "private": true,
  "description": "Universal Aegis client (Android, iOS, web) with role-aware navigation",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "export:web": "expo export --platform web",
    "align": "expo install --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aegis/contracts": "workspace:*",
    "@aegis/ui": "workspace:*",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "5.104.1",
    "expo": "57.0.26",
    "expo-constants": "57.0.20",
    "expo-crypto": "57.0.3",
    "expo-linking": "57.0.11",
    "expo-router": "57.0.24",
    "expo-secure-store": "57.0.4",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "0.21.3",
    "socket.io-client": "4.8.4",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "19.2.18"
  }
}
