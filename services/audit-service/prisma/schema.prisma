// audit-service database (aegis_audit). DDL, triggers, hash chain, and RLS live in reviewed SQL.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model AuditEvent {
  id            String   @id @db.Uuid
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(6)
  recordedAt    DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  originService String   @map("origin_service")
  userId        String?  @map("user_id") @db.Uuid
  sessionId     String?  @map("session_id") @db.Uuid
  schoolId      String?  @map("school_id") @db.Uuid
  eventType     String   @map("event_type")
  outcome       String
  sourceIp      String?  @map("source_ip")
  userAgent     String?  @map("user_agent")
  correlationId String   @map("correlation_id")
  details       Json     @default("{}")

  @@map("audit_events")
}

model ActivityJournal {
  id                String   @id @db.Uuid
  chainKey          String   @map("chain_key")
  chainPosition     BigInt   @map("chain_position")
  occurredAt        DateTime @map("occurred_at") @db.Timestamptz(6)
  recordedAt        DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  workspaceType     String   @map("workspace_type")
  workspaceId       String   @map("workspace_id") @db.Uuid
  schoolId          String?  @map("school_id") @db.Uuid
  actorUserId       String?  @map("actor_user_id") @db.Uuid
  operatorProfileId String?  @map("operator_profile_id") @db.Uuid
  sessionId         String?  @map("session_id") @db.Uuid
  grantId           String?  @map("grant_id") @db.Uuid
  fencingToken      BigInt?  @map("fencing_token")
  originService     String   @map("origin_service")
  action            String
  targetType        String   @map("target_type")
  targetId          String?  @map("target_id")
  outcome           String
  correlationId     String   @map("correlation_id")
  sourceIp          String?  @map("source_ip")
  userAgent         String?  @map("user_agent")
  changes           Json
  prevHash          String   @map("prev_hash")
  entryHash         String   @map("entry_hash")

  @@unique([chainKey, chainPosition])
  @@map("activity_journal")
}

model InboxMessage {
  eventId    String   @map("event_id") @db.Uuid
  consumer   String
  eventType  String   @map("event_type")
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@id([eventId, consumer])
  @@map("inbox_messages")
}

model OutboxMessage {
  id            String    @id @db.Uuid
  routingKey    String    @map("routing_key")
  envelope      Json
  priority      Int       @default(5) @db.SmallInt
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)

  @@map("outbox_messages")
}
