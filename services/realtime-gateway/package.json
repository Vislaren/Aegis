{
  "name": "@aegis/realtime-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Authenticated Socket.IO fan-out; privileged subscriptions require a live lease",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "dev": "tsc -p tsconfig.build.json && node --enable-source-maps --env-file-if-exists=.env dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run -c vitest.integration.config.mts --passWithNoTests"
  },
  "dependencies": {
    "@aegis/config": "workspace:*",
    "@aegis/contracts": "workspace:*",
    "@aegis/domain": "workspace:*",
    "@aegis/observability": "workspace:*",
    "@aegis/service-kit": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "fastify": "5.12.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "tsx": "4.23.15"
  }
}
