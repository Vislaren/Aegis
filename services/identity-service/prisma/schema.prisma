// identity-service database (aegis_identity). DDL lives in reviewed SQL migrations.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  displayName       String    @map("display_name")
  email             String?   @unique
  phoneE164         String?   @unique @map("phone_e164")
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt   DateTime? @map("phone_verified_at") @db.Timestamptz(6)
  status            String
  requiresMfa       Boolean   @default(false) @map("requires_mfa")
  preferredLanguage String    @default("en") @map("preferred_language")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  factors     AuthFactor[]
  sessions    Session[]
  invitations Invitation[]
  devices     TrustedDevice[]
  consents    ConsentRecord[]

  @@map("users")
}

model AuthFactor {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  type             String
  secretCiphertext String    @map("secret_ciphertext")
  status           String
  lastUsedStep     BigInt?   @map("last_used_step")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  activatedAt      DateTime? @map("activated_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@map("auth_factors")
}

model Invitation {
  id                  String    @id @default(uuid()) @db.Uuid
  invitationRequestId String    @unique @map("invitation_request_id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  schoolId            String?   @map("school_id") @db.Uuid
  schoolName          String?   @map("school_name")
  kind                String
  role                String
  tokenHash           String    @unique @map("token_hash")
  status              String
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(6)
  deliveredAt         DateTime? @map("delivered_at") @db.Timestamptz(6)
  acceptedAt          DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User           @relation(fields: [userId], references: [id])
  challenges OtpChallenge[]

  @@map("invitations")
}

model OtpChallenge {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String?   @map("user_id") @db.Uuid
  purpose         String
  channel         String
  destinationHash String    @map("destination_hash")
  codeHash        String    @map("code_hash")
  deliverable     Boolean
  invitationId    String?   @map("invitation_id") @db.Uuid
  attempts        Int       @default(0)
  maxAttempts     Int       @map("max_attempts")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt      DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdIp       String?   @map("created_ip")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  invitation Invitation? @relation(fields: [invitationId], references: [id])

  @@map("otp_challenges")
}

model TrustedDevice {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  deviceIdHash String    @map("device_id_hash")
  platform     String
  deviceName   String?   @map("device_name")
  firstSeenAt  DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id])
  sessions Session[]

  @@unique([userId, deviceIdHash])
  @@map("trusted_devices")
}

model Session {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  status            String
  aal               Int            @db.SmallInt
  authenticatedAt   DateTime       @map("authenticated_at") @db.Timestamptz(6)
  mfaVerifiedAt     DateTime?      @map("mfa_verified_at") @db.Timestamptz(6)
  mfaFailures       Int            @default(0) @map("mfa_failures") @db.SmallInt
  clientType        String         @map("client_type")
  platform          String
  trustedDeviceId   String?        @map("trusted_device_id") @db.Uuid
  deviceName        String?        @map("device_name")
  userAgent         String?        @map("user_agent")
  ip                String?
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt        DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime       @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?      @map("revoked_at") @db.Timestamptz(6)
  revokeReason      String?        @map("revoke_reason")

  user          User           @relation(fields: [userId], references: [id])
  trustedDevice TrustedDevice? @relation(fields: [trustedDeviceId], references: [id])
  refreshTokens RefreshToken[]

  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  parentId  String?   @map("parent_id") @db.Uuid
  status    String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id])

  @@map("refresh_tokens")
}

model ConsentRecord {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  documentType    String   @map("document_type")
  documentVersion String   @map("document_version")
  acceptedAt      DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)
  ip              String?
  userAgent       String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id])

  @@map("consent_records")
}

model OutboxMessage {
  id            String    @id @db.Uuid
  routingKey    String    @map("routing_key")
  envelope      Json
  priority      Int       @default(5) @db.SmallInt
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)

  @@map("outbox_messages")
}

model InboxMessage {
  eventId    String   @map("event_id") @db.Uuid
  consumer   String
  eventType  String   @map("event_type")
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@id([eventId, consumer])
  @@map("inbox_messages")
}
