// administration-service database (aegis_administration).
// System of record for tenants, administration workspaces, operators, memberships, roles,
// feature flags, and privileged access leases. DDL is authored in reviewed SQL migrations
// (prisma/migrations); this schema mirrors it for the typed client.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Role {
  key         String  @id
  scope       String
  privileged  Boolean
  featureFlag String? @map("feature_flag")

  @@unique([key, scope])
  @@map("roles")
}

model PlatformAdministrationWorkspace {
  id        String   @id @db.Uuid
  name      String
  singleton Boolean  @unique @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  operators PlatformAdminOperatorProfile[]

  @@map("platform_administration_workspaces")
}

model PlatformAdminOperatorProfile {
  id                  String    @id @default(uuid()) @db.Uuid
  workspaceId         String    @map("workspace_id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  displayName         String    @map("display_name")
  contactMasked       String    @map("contact_masked")
  status              String
  invitationRequestId String?   @unique @map("invitation_request_id") @db.Uuid
  createdByUserId     String?   @map("created_by_user_id") @db.Uuid
  effectiveFrom       DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo         DateTime? @map("effective_to") @db.Timestamptz(6)
  activatedAt         DateTime? @map("activated_at") @db.Timestamptz(6)
  statusReason        String?   @map("status_reason")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace PlatformAdministrationWorkspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, userId])
  @@map("platform_admin_operator_profiles")
}

model School {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  slug             String   @unique
  status           String
  timezone         String
  countryCode      String   @map("country_code")
  defaultLanguage  String   @map("default_language")
  createdByUserId  String?  @map("created_by_user_id") @db.Uuid
  statusReason     String?  @map("status_reason")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  settings    SchoolSettings?
  workspace   SchoolAdministrationWorkspace?
  memberships SchoolMembership[]
  operators   SchoolAdminOperatorProfile[]

  @@map("schools")
}

model SchoolSettings {
  schoolId                      String   @id @map("school_id") @db.Uuid
  staleLocationThresholdSeconds Int      @default(60) @map("stale_location_threshold_seconds")
  absenceCutoffMinutes          Int      @default(30) @map("absence_cutoff_minutes")
  gpsRetentionDays              Int      @default(30) @map("gps_retention_days")
  notificationRetentionDays     Int      @default(90) @map("notification_retention_days")
  supportEmail                  String?  @map("support_email")
  supportPhone                  String?  @map("support_phone")
  updatedAt                     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id])

  @@map("school_settings")
}

model SchoolAdministrationWorkspace {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @unique @map("school_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  school    School                       @relation(fields: [schoolId], references: [id])
  operators SchoolAdminOperatorProfile[]

  @@unique([id, schoolId])
  @@map("school_administration_workspaces")
}

model SchoolAdminOperatorProfile {
  id                  String    @id @default(uuid()) @db.Uuid
  workspaceId         String    @map("workspace_id") @db.Uuid
  schoolId            String    @map("school_id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  displayName         String    @map("display_name")
  contactMasked       String    @map("contact_masked")
  status              String
  invitationRequestId String?   @unique @map("invitation_request_id") @db.Uuid
  createdByUserId     String?   @map("created_by_user_id") @db.Uuid
  effectiveFrom       DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo         DateTime? @map("effective_to") @db.Timestamptz(6)
  activatedAt         DateTime? @map("activated_at") @db.Timestamptz(6)
  statusReason        String?   @map("status_reason")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace SchoolAdministrationWorkspace @relation(fields: [workspaceId, schoolId], references: [id, schoolId])
  school    School                        @relation(fields: [schoolId], references: [id])

  @@unique([workspaceId, userId])
  @@map("school_admin_operator_profiles")
}

model SchoolMembership {
  id                  String   @id @default(uuid()) @db.Uuid
  schoolId            String   @map("school_id") @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  displayName         String   @map("display_name")
  contactMasked       String   @map("contact_masked")
  status              String
  invitationRequestId String?  @unique @map("invitation_request_id") @db.Uuid
  createdByUserId     String?   @map("created_by_user_id") @db.Uuid
  activatedAt         DateTime? @map("activated_at") @db.Timestamptz(6)
  statusReason        String?   @map("status_reason")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  school          School           @relation(fields: [schoolId], references: [id])
  roleAssignments RoleAssignment[]

  @@unique([schoolId, userId])
  @@unique([id, schoolId])
  @@map("school_memberships")
}

model RoleAssignment {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  schoolId        String?   @map("school_id") @db.Uuid
  membershipId    String?   @map("membership_id") @db.Uuid
  roleKey         String    @map("role_key")
  roleScope       String    @map("role_scope")
  status          String
  grantedByUserId String?   @map("granted_by_user_id") @db.Uuid
  grantedAt       DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid

  membership SchoolMembership? @relation(fields: [membershipId, schoolId], references: [id, schoolId])

  @@map("role_assignments")
}

model FeatureFlag {
  id              String   @id @default(uuid()) @db.Uuid
  key             String
  schoolId        String?  @map("school_id") @db.Uuid
  enabled         Boolean
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("feature_flags")
}

model PrivilegedAccessLease {
  id                  String    @id @default(uuid()) @db.Uuid
  workspaceType       String    @map("workspace_type")
  workspaceId         String    @map("workspace_id") @db.Uuid
  schoolId            String?   @map("school_id") @db.Uuid
  status              String
  grantId             String?   @map("grant_id") @db.Uuid
  fencingToken        BigInt    @default(0) @map("fencing_token")
  version             Int       @default(0)
  ownerUserId         String?   @map("owner_user_id") @db.Uuid
  operatorProfileId   String?   @map("operator_profile_id") @db.Uuid
  operatorDisplayName String?   @map("operator_display_name")
  sessionId           String?   @map("session_id") @db.Uuid
  acquiredAt          DateTime? @map("acquired_at") @db.Timestamptz(6)
  heartbeatAt         DateTime? @map("heartbeat_at") @db.Timestamptz(6)
  lastActivityAt      DateTime? @map("last_activity_at") @db.Timestamptz(6)
  expiresAt           DateTime? @map("expires_at") @db.Timestamptz(6)
  idleExpiresAt       DateTime? @map("idle_expires_at") @db.Timestamptz(6)
  releasedAt          DateTime? @map("released_at") @db.Timestamptz(6)
  releaseReason       String?   @map("release_reason")
  releasedByUserId    String?   @map("released_by_user_id") @db.Uuid
  takeoverOfGrantId   String?   @map("takeover_of_grant_id") @db.Uuid
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([workspaceType, workspaceId])
  @@map("privileged_access_leases")
}

model PrivilegedSessionHistory {
  id                  String    @id @default(uuid()) @db.Uuid
  workspaceType       String    @map("workspace_type")
  workspaceId         String    @map("workspace_id") @db.Uuid
  schoolId            String?   @map("school_id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  operatorProfileId   String?   @map("operator_profile_id") @db.Uuid
  operatorDisplayName String?   @map("operator_display_name")
  sessionId           String    @map("session_id") @db.Uuid
  grantId             String?   @map("grant_id") @db.Uuid
  fencingToken        BigInt?   @map("fencing_token")
  outcome             String
  attemptedAt         DateTime  @default(now()) @map("attempted_at") @db.Timestamptz(6)
  acquiredAt          DateTime? @map("acquired_at") @db.Timestamptz(6)
  lastActiveAt        DateTime? @map("last_active_at") @db.Timestamptz(6)
  endedAt             DateTime? @map("ended_at") @db.Timestamptz(6)
  endReason           String?   @map("end_reason")
  sourceIp            String?   @map("source_ip")
  userAgent           String?   @map("user_agent")
  correlationId       String    @map("correlation_id")
  riskSignals         Json      @default("{}") @map("risk_signals")

  @@map("privileged_session_history")
}

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  actorUserId    String   @map("actor_user_id") @db.Uuid
  key            String
  operation      String
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([actorUserId, key])
  @@map("idempotency_records")
}

model SupportAccessGrant {
  id                String    @id @default(uuid()) @db.Uuid
  schoolId          String    @map("school_id") @db.Uuid
  requestedByUserId String    @map("requested_by_user_id") @db.Uuid
  approvedByUserId  String?   @map("approved_by_user_id") @db.Uuid
  reason            String
  scope             String
  status            String
  startsAt          DateTime? @map("starts_at") @db.Timestamptz(6)
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("support_access_grants")
}

model OutboxMessage {
  id            String    @id @db.Uuid
  routingKey    String    @map("routing_key")
  envelope      Json
  priority      Int       @default(5) @db.SmallInt
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)

  @@map("outbox_messages")
}

model InboxMessage {
  eventId    String   @map("event_id") @db.Uuid
  consumer   String
  eventType  String   @map("event_type")
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@id([eventId, consumer])
  @@map("inbox_messages")
}
