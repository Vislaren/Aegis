{
  "name": "@aegis/administration-service",
  "version": "0.1.0",
  "private": true,
  "description": "Tenants, administration workspaces, operators, memberships, roles, privileged leases",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.e2e.json",
    "lint": "eslint src test",
    "dev": "tsc -p tsconfig.build.json && node --enable-source-maps --env-file-if-exists=.env dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run -c vitest.integration.config.mts --passWithNoTests",
    "dev:worker": "node --enable-source-maps --env-file-if-exists=.env dist/worker.js",
    "bootstrap:platform-operator": "tsx --env-file-if-exists=.env scripts/bootstrap-platform-operator.ts",
    "test:e2e": "vitest run -c vitest.e2e.config.mts",
    "prisma:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --script"
  },
  "dependencies": {
    "@aegis/config": "workspace:*",
    "@aegis/contracts": "workspace:*",
    "@aegis/domain": "workspace:*",
    "@aegis/observability": "workspace:*",
    "@aegis/service-kit": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15"
  }
}
